NODE_ENV=production
PORT=3007

# JWT — 部署时脚本会自动生成随机密钥替换下面两行
JWT_SECRET=replace-with-64-char-random-string
JWT_REFRESH_SECRET=replace-with-another-64-char-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# MySQL — 改成你的阿里云数据库信息
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=meoo
DB_PASSWORD=改成你的数据库密码
DB_NAME=meoo_prod
DB_POOL_MIN=2
DB_POOL_MAX=10

# CORS — 改成你的实际域名
ALLOWED_ORIGINS=https://你的域名.xyz

# 管理员用户名（逗号分隔）
ADMIN_USERNAMES=admin
