{
  "name": "pdd-order-analyzer",
  "version": "1.0.0",
  "scripts": {
    "dev": "webpack serve",
    "build": "webpack --mode production",
    "postbuild": "node -e \"const fs=require('fs');let c=fs.readFileSync('index.html','utf8');c=c.replace(/var VER = \\\"[a-f0-9]+\\\";/,'var VER = \\\"BUILD_HASH_PLACEHOLDER\\\";');fs.writeFileSync('index.html',c,'utf8')\" 2>/dev/null; node -e \"const{cpSync}=require('fs');[{s:'演示数据_订单.csv',d:'demo_orders.csv'},{s:'演示数据_商品推广.xlsx',d:'demo_promo.xlsx'},{s:'演示数据_售后.xlsx',d:'demo_aftersale.xlsx'},{s:'演示数据_运费险.xlsx',d:'demo_insurance.xlsx'},{s:'演示数据_货款明细.csv',d:'demo_finance.csv'}].forEach(f=>{try{cpSync('public/assets/'+f.s,'dist/'+f.d)}catch(e){}})\"",
    "typecheck": "tsc --noEmit",
    "prebuild": "node -e \"const fs=require('fs'),h=require('crypto').randomBytes(4).toString('hex');let c=fs.readFileSync('index.html','utf8');c=c.replace('BUILD_HASH_PLACEHOLDER',h);fs.writeFileSync('index.html',c,'utf8');console.log('Build hash:',h)\""
  },
