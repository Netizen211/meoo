"import React, { useMemo, useState, useEffect } from 'react';\nimport { TrendingUp, DollarSign, ShoppingCart, ArrowUp, ArrowDown, ChevronLeft, ChevronRight, X, Search, Download, Target, RotateCcw, BarChart3, Eye, ExternalLink } from 'lucide-react';\nimport { useData } from '../App';\nimport { findField } from '../utils';\nimport DashboardDetailModal from './dashboard/DashboardDetailModal';\nimport { useTimeFilter, safeFloat, filterByTimeRange, filterPromoByTimeRange, getAllDateGroups, changePct, getQuickRangeDates } from '../components/TimeFilter';\nimport FilterToolbar from '../components/FilterToolbar';\nimport { useProductDetail, ProductStat } from '../components/ProductLinkStats';\nimport { useStore } from '../App';\nimport { apiClient } from '../../api/client';\nimport ProductDeepAnalysis from './product/ProductDeepAnalysis';\nimport { AnalysisProvider } from '../context/analysisContext';\nimport { SEMANTIC, CHART } from '../ui/tokens/colors';\n\nconst COLORS = [CHART.all[0], CHART.all[1], CHART.all[2], '#eab308', SEMANTIC.profit, CHART.primary[4], CHART.extended[0], CHART.extended[1]];\n\n// ─── Sparkline 微型折线图 ────────────────────────\nconst Sparkline = ({ data, width = 56, height = 20, color = '#C9CDD4' }: { data: number[]; width?: number; height?: number; color?: string }) => {\n if (!data || data.length < 2 || data.every(v => v === 0)) return <span className=\"inline-block align-middle\" style={{ width, height }} />;\n const min = Math.min(...data), max = Math.max(...data), range = max - min || 1;\n const pts = data.map((v, i) => `${((i / (data.length - 1)) * (width - 6) + 3)},${height - 3 - ((v - min) / range) * (height - 6)}`).join(' ');\n return (\n <svg width={width} height={height} className=\"shrink-0 align-middle overflow-visible\">\n <defs><linearGradient id={`sg-${color.replace('#','')}`} x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0%\" stopColor={color} stopOpacity=\"0.12\" /><stop offset=\"100%\" stopColor={color} stopOpacity=\"0.01\" /></linearGradient></defs>\n <path d={`M${pts} L${width - 3},${height - 3} L3,${height - 3} Z`} fill={`url(#sg-${color.replace('#','')})`} />\n <polyline points={pts} fill=\"none\" stroke={color} strokeWidth={1.5} strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n </svg>\n );\n};\n\n// ─── 列定义（可排序） ────────────────────────────\ninterface ColumnDef {\n key: string;\n label: string;\n align?: 'left' | 'right';\n width?: string;\n sortable?: boolean;\n render: (p: any) => React.ReactNode;\n}\n\nexport default function ProductPage() {\n const { currentDisplayData, productCosts, defaultCostRatio, shippingFeePerOrder, platformCommissionRate, insuranceFeePerOrder, abnormalOrders } = useData();\n const tf = useTimeFilter('7', 'day');\n const { timeRange, granularity, compareEnabled, useNaturalDate, setUseNaturalDate, setTimeRange, setGranularity, setCompareEnabled, customStart, customEnd, compareStart, compareEnd, quickRange, setCustomRange, setQuickRange, savedRanges, saveCurrentRange, deleteSavedRange, applySavedRange } = tf;\n const [searchKeyword, setSearchKeyword] = useState('');\n const [sortField, setSortField] = useState<string>('gmv');\n const [sortDesc, setSortDesc] = useState(true);\n const [currentPage, setCurrentPage] = useState(1);\n const [selectedProduct, setSelectedProduct] = useState<string | null>(null);\n const [deepAnalysisOpen, setDeepAnalysisOpen] = useState(false);\n const [deepAnalysisProductId, setDeepAnalysisProductId] = useState<string | undefined>(undefined);\n const [detailModal, setDetailModal] = useState<{open:boolean;title:string;data:any[];columns:any[]}>({open:false,title:\"\",data:[],columns:[]});\n const pageSize = 10;\n\n const pageSize = 10;\n\n const orders = useMemo(() => {\n if (!currentDisplayData?.orders?.length) return [];\n return currentDisplayData.orders.filter((o: any) => String(findField(o, '订单状态', '状态') || '').trim() !== '已取消');\n }, [currentDisplayData]);\n\n const allDates = useMemo(() => getAllDateGroups(orders), [orders]);\n const prevOrders = useMemo(() => getCompareOrders(orders, allDates, timeRange, compareStart, compareEnd, customStart, customEnd, quickRange), [orders, allDates, timeRange, compareStart, compareEnd, customStart, customEnd, quickRange]);\n const prevFilteredOrders = useMemo(() => {\n let result = prevOrders;\n if (abnormalOrders && Object.keys(abnormalOrders).length > 0) {\n result = result.filter(o => {\n const orderNo = String(findField(o, '订单号') || '').trim();\n const ab = orderNo ? abnormalOrders[orderNo] : null;\n return !(ab && ab.status === 'excluded');\n });\n }\n return result;\n }, [prevOrders, abnormalOrders]);\n const filteredOrders = useMemo(() => {\n let result = filterByTimeRange(orders, allDates, timeRange, customStart, customEnd, quickRange, useNaturalDate);\n // 剔除用户标记为排除的异常订单\n if (abnormalOrders && Object.keys(abnormalOrders).length > 0) {\n result = result.filter(o => {\n const orderNo = String(findField(o, '订单号') || '').trim();\n const ab = orderNo ? abnormalOrders[orderNo] : null;\n return !(ab && ab.status === 'excluded');\n });\n }\n return result;\n }, [orders, allDates, timeRange, customStart, customEnd, quickRange, abnormalOrders]);\n\n // 构建时间过滤后的 displayData 供 useProductStats 使用\n const filteredDisplayData = useMemo(() => {\n if (!currentDisplayData) return null;\n return {\n ...currentDisplayData,\n orders: filteredOrders,\n afterSaleRecords: filterPromoByTimeRange(currentDisplayData.afterSaleRecords || [], allDates, timeRange, ['申请时间'], customStart, customEnd, quickRange, useNaturalDate),\n promotionProducts: filterPromoByTimeRange(currentDisplayData.promotionProducts || [], allDates, timeRange, undefined, customStart, customEnd, quickRange, useNaturalDate),\n promotionSummary: filterPromoByTimeRange(currentDisplayData.promotionSummary || [], allDates, timeRange, undefined, customStart, customEnd, quickRange, useNaturalDate),\n starStoreSummary: filterPromoByTimeRange(currentDisplayData.starStoreSummary || [], allDates, timeRange, undefined, customStart, customEnd, quickRange, useNaturalDate),\n liveStreamSummary: filterPromoByTimeRange(currentDisplayData.liveStreamSummary || [], allDates, timeRange, undefined, customStart, customEnd, quickRange, useNaturalDate),\n shippingInsurance: filterPromoByTimeRange(currentDisplayData.shippingInsurance || [], allDates, timeRange, ['日期'], customStart, customEnd, quickRange, useNaturalDate),\n };\n }, [currentDisplayData, filteredOrders, allDates, timeRange, customStart, customEnd, quickRange]);\n\n // 上一周期日期范围（用于过滤非订单数据）\n const prevPeriodDates = useMemo(() => {\n if (!allDates.length || timeRange === 'all') return null;\n\n let currentStart: Date;\n let currentEnd: Date;\n\n if (timeRange === 'custom' && quickRange) {\n const dates = getQuickRangeDates(quickRange);\n currentStart = new Date(dates.start);\n currentEnd = new Date(dates.end);\n } else if (timeRange === 'custom' && customStart && customEnd) {\n currentStart = new Date(customStart);\n currentEnd = new Date(customEnd);\n } else if (timeRange === 'custom' || isNaN(parseInt(timeRange))) {\n return null;\n } else {\n const lastDate = allDates[allDates.length - 1][0];\n const lastD = new Date(lastDate);\n const rangeDays = parseInt(timeRange) || 7;\n currentEnd = lastD;\n currentStart = new Date(lastD);\n currentStart.setDate(currentStart.getDate() - rangeDays + 1);\n }\n\n if (isNaN(currentStart.getTime()) || isNaN(currentEnd.getTime())) return null;\n\n const periodDays = Math.ceil((currentEnd.getTime() - currentStart.getTime()) / 86400000) + 1;\n const prevEnd = new Date(currentStart);\n prevEnd.setDate(prevEnd.getDate() - 1);\n const prevStart = new Date(prevEnd);\n prevStart.setDate(prevStart.getDate() - periodDays + 1);\n\n return {\n start: prevStart.toISOString().split('T')[0],\n end: prevEnd.toISOString().split('T')[0],\n };\n }, [allDates, timeRange, customStart, customEnd, quickRange]);\n\n // 按指定日期范围过滤非订单数据\n const filterByDateRange = (data: any[], dateField: string, startDate: string, endDate: string) => {\n if (!data || !data.length) return data || [];\n return data.filter(item => {\n const dateStr = dateField ? item[dateField] : (item['日期'] || item['申请时间'] || item['支付时间'] || '');\n if (!dateStr) return true;\n const d = String(dateStr).trim().split(' ')[0];\n if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(d)) return true;\n return d >= startDate && d <= endDate;\n });\n };\n\n // 上一周期数据（用于同比/环比）\n const prevDisplayData = useMemo(() => {\n if (!currentDisplayData) return null;\n if (!prevPeriodDates) {\n return {\n ...currentDisplayData,\n orders: prevFilteredOrders,\n };\n }\n const { start, end } = prevPeriodDates;\n return {\n ...currentDisplayData,\n orders: prevFilteredOrders,\n afterSaleRecords: filterByDateRange(currentDisplayData.afterSaleRecords || [], '申请时间', start, end),\n promotionProducts: filterByDateRange(currentDisplayData.promotionProducts || [], '日期', start, end),\n promotionSummary: filterByDateRange(currentDisplayData.promotionSummary || [], '日期', start, end),\n starStoreSummary: filterByDateRange(currentDisplayData.starStoreSummary || [], '日期', start, end),\n liveStreamSummary: filterByDateRange(currentDisplayData.liveStreamSummary || [], '日期', start, end),\n shippingInsurance: filterByDateRange(currentDisplayData.shippingInsurance || [], '日期', start, end),\n };\n }, [currentDisplayData, prevFilteredOrders, prevPeriodDates]);\n\n // ★ 服务端计算商品统计（替代浏览器端 useProductStats 945行）\n const { currentStore } = useStore();\n const [productStats, setProductStats] = useState<Record<string, ProductStat>>({});\n const [prevProductStats, setPrevProductStats] = useState<Record<string, ProductStat>>({});\n const [statsLoading, setStatsLoading] = useState(false);\n\n useEffect(() => {\n const sid = currentStore?.id;\n if (!sid) return;\n setStatsLoading(true);\n // ★ 传递 timeRange 让后端按时间范围过滤（不含自定义，后端暂不支持）\n const tr = timeRange === 'custom' ? 'all' : (timeRange || 'all');\n // ★ 上一周期：相同的天数往前推（用于环比）\n const prevTr = tr !== 'all' ? tr : undefined;\n apiClient.get(`/analytics/products/stats?storeId=${encodeURIComponent(sid)}&timeRange=${tr}${prevTr ? `&prevTimeRange=${prevTr}` : ''}`)\n .then(res => {\n if (res.success) {\n if (res.data) setProductStats(res.data);\n if ((res as any).prevData) setPrevProductStats((res as any).prevData);\n }\n })\n .catch(() => {})\n .finally(() => setStatsLoading(false));\n }, [currentStore?.id, timeRange, productCosts]);\n const drawerProduct = useProductDetail(productStats, drawerProductId);\n const compareOrders = useMemo(() => compareEnabled ? getCompareOrders(orders, allDates, timeRange, compareStart, compareEnd, customStart, customEnd, quickRange) : [], [orders, allDates, timeRange, compareStart, compareEnd, customStart, customEnd, quickRange, compareEnabled]);\n\n // Convert productStats to list format for table display\n const products = useMemo(() => {\n return Object.values(productStats).map(s => ({\n id: s.productId,\n name: s.productName,\n code: s.productCode,\n sales: s.sales,\n revenue: s.revenue,\n orders: s.orders,\n afterSale: s.afterSaleCount,\n refund: s.refund,\n refundCount: s.refundCount || 0,\n costs: s.totalCost,\n avgPrice: s.avgOrderValue,\n afterSaleRate: s.afterSaleRate,\n refundRate: s.refundRate,\n profit: s.netProfit,\n profitRate: s.profitRate,\n gmv: s.gmv,\n promoCost: s.promoCost,\n promoTransaction: s.promoTransaction,\n promoClicks: s.promoClicks,\n promoImpressions: s.promoImpressions,\n roi: s.roi,\n grossProfit: s.grossProfit || 0,\n preTaxProfit: s.preTaxProfit || 0,\n netProfitAfterTax: s.netProfitAfterTax || s.netProfit,\n costBreakdown: s.costBreakdown || { productCost: 0, packagingFee: 0, shippingFee: 0, promoCost: 0, discount: 0, platformFee: 0, taxes: 0, customDeductions: 0 },\n costSource: s.costSource || { productCost: 'missing', taxes: 'default', customDeductions: 'none' },\n taxDetails: s.taxDetails || [],\n deductionDetails: s.deductionDetails || [],\n profitConfidence: s.profitConfidence || 'low',\n discountRatio: s.discountRatio,\n promoCostRatio: s.promoCostRatio,\n firstDate: s.firstOrderDate,\n lastDate: s.lastOrderDate,\n tags: productTags[s.productId] || [],\n inventory: s.inventoryEstimate,\n inventoryStatus: (s.avgDailySales ?? 0) <= 0 ? 'out' : (s.avgDailySales ?? 0) < 2 ? 'low' : 'normal',\n activeDays: s.activeDays,\n avgDailySales: s.avgDailySales,\n turnoverDays: s.turnoverDays,\n sellThroughRate: s.sellThroughRate,\n }));\n }, [productStats, productTags]);\n\n // 上一周期商品列表（用于环比计算）\n const prevProducts = useMemo(() => {\n return Object.values(prevProductStats).map(s => ({\n id: s.productId,\n name: s.productName,\n code: s.productCode,\n sales: s.sales,\n revenue: s.revenue,\n orders: s.orders,\n afterSale: s.afterSaleCount,\n refund: s.refund,\n refundCount: s.refundCount || 0,\n costs: s.totalCost,\n avgPrice: s.avgOrderValue,\n afterSaleRate: s.afterSaleRate,\n refundRate: s.refundRate,\n profit: s.netProfit,\n profitRate: s.profitRate,\n gmv: s.gmv,\n promoCost: s.promoCost,\n promoTransaction: s.promoTransaction,\n promoClicks: s.promoClicks,\n promoImpressions: s.promoImpressions,\n roi: s.roi,\n grossProfit: s.grossProfit || 0,\n preTaxProfit: s.preTaxProfit || 0,\n netProfitAfterTax: s.netProfitAfterTax || s.netProfit,\n discountRatio: s.discountRatio,\n promoCostRatio: s.promoCostRatio,\n firstDate: s.firstOrderDate,\n lastDate: s.lastOrderDate,\n inventory: s.inventoryEstimate,\n inventoryStatus: (s.avgDailySales ?? 0) <= 0 ? 'out' : (s.avgDailySales ?? 0) < 2 ? 'low' : 'normal',\n activeDays: s.activeDays,\n avgDailySales: s.avgDailySales,\n turnoverDays: s.turnoverDays,\n sellThroughRate: s.sellThroughRate,\n }));\n }, [prevProductStats]);\n\n const filteredProducts = useMemo(() => {\n let result = products;\n // 搜索过滤：支持商品ID、商品名称、商家编码\n if (searchKeyword.trim()) {\n const kw = searchKeyword.trim().toLowerCase();\n result = result.filter(p =>\n (p.id && p.id.toLowerCase().includes(kw)) ||\n (p.name && p.name.toLowerCase().includes(kw)) ||\n (p.code && p.code.toLowerCase().includes(kw))\n );\n }\n if (priceFilter !== 'all') {\n const [min, max] = priceFilter.split('-').map(v => v === 'max' ? Infinity : parseInt(v));\n result = result.filter(p => p.avgPrice >= min && p.avgPrice < (max || Infinity));\n }\n if (salesFilter !== 'all') {\n const [min, max] = salesFilter.split('-').map(v => v === 'max' ? Infinity : parseInt(v));\n result = result.filter(p => p.sales >= min && p.sales < (max || Infinity));\n }\n if (afterSaleFilter !== 'all') {\n const [min, max] = afterSaleFilter.split('-').map(v => v === 'max' ? Infinity : parseInt(v));\n result = result.filter(p => p.afterSaleRate >= min && p.afterSaleRate < (max || Infinity));\n }\n return result;\n }, [products, priceFilter, salesFilter, afterSaleFilter, searchKeyword]);\n\n const sortedProducts = useMemo(() => {\n const sorted = [...filteredProducts].sort((a: any, b: any) => {\n const av = a[sortField], bv = b[sortField];\n if (typeof av === 'number' && typeof bv === 'number') return sortDesc ? bv - av : av - bv;\n return sortDesc ? String(bv).localeCompare(String(av)) : String(av).localeCompare(String(bv));\n });\n return sorted;\n }, [filteredProducts, sortField, sortDesc]);\n\n const paginatedProducts = useMemo(() => sortedProducts.slice((currentPage - 1) * pageSize, currentPage * pageSize), [sortedProducts, currentPage]);\n const totalPages = Math.ceil(sortedProducts.length / pageSize);\n\n const kpiMetrics = useMemo(() => {\n if (!filteredProducts.length) return null;\n const productIds = new Set(filteredProducts.map(p => p.id));\n const totalSales = filteredProducts.reduce((s, p) => s + p.sales, 0);\n const totalRevenue = filteredProducts.reduce((s, p) => s + p.revenue, 0);\n const totalProfit = filteredProducts.reduce((s, p) => s + p.profit, 0);\n const totalGmv = filteredProducts.reduce((s, p) => s + p.gmv, 0);\n const avgPrice = filteredProducts.length > 0 ? totalRevenue / filteredProducts.reduce((s, p) => s + p.orders, 0) : 0;\n const afterSaleCount = filteredProducts.reduce((s, p) => s + p.afterSale, 0);\n const totalOrders = filteredProducts.reduce((s, p) => s + p.orders, 0);\n const afterSaleRate = totalOrders > 0 ? (afterSaleCount / totalOrders) * 100 : 0;\n const zeroSales = filteredProducts.filter(p => p.sales <= 0).length;\n const lowInventory = filteredProducts.filter(p => p.inventoryStatus === 'low').length;\n const activeProducts = filteredProducts.filter(p => p.sales > 0).length;\n const sellThroughRate = filteredProducts.length > 0 ? (activeProducts / filteredProducts.length) * 100 : 0;\n const avgTurnover = filteredProducts.reduce((s, p) => s + (p.turnoverDays < 999 ? p.turnoverDays : 0), 0) / (filteredProducts.filter(p => p.turnoverDays < 999).length || 1);\n const avgPromoRatio = filteredProducts.reduce((s, p) => s + p.promoCostRatio, 0) / (filteredProducts.length || 1);\n const totalRefundOrders = filteredProducts.reduce((s, p) => s + (p.refundCount || 0), 0);\n const refundRate = totalOrders > 0 ? (totalRefundOrders / totalOrders) * 100 : 0;\n const totalPromoCost = filteredProducts.reduce((s, p) => s + p.promoCost, 0);\n const totalPromoClicks = filteredProducts.reduce((s, p) => s + (p.promoClicks || 0), 0);\n const totalRefundAmount = filteredProducts.reduce((s, p) => s + (p.refund || 0), 0);\n\n // 计算环比变化\n const diffs: Record<string, number | null> = {};\n const prevMatched = prevProducts.filter(p => productIds.has(p.id));\n if (prevMatched.length > 0) {\n const prevSales = prevMatched.reduce((s, p) => s + p.sales, 0);\n const prevRevenue = prevMatched.reduce((s, p) => s + p.revenue, 0);\n const prevProfit = prevMatched.reduce((s, p) => s + p.profit, 0);\n const prevGmv = prevMatched.reduce((s, p) => s + p.gmv, 0);\n const prevOrders = prevMatched.reduce((s, p) => s + p.orders, 0);\n const prevActive = prevMatched.filter(p => p.sales > 0).length;\n const prevAvgPrice = prevOrders > 0 ? prevRevenue / prevOrders : 0;\n const prevSellThrough = prevMatched.length > 0 ? (prevActive / prevMatched.length) * 100 : 0;\n const prevPromoCost = prevMatched.reduce((s, p) => s + p.promoCost, 0);\n const prevRefundAmount = prevMatched.reduce((s, p) => s + (p.refund || 0), 0);\n diffs.productCount = changePct(productIds.size, prevMatched.length);\n diffs.totalGmv = changePct(totalGmv, prevGmv);\n diffs.totalRevenue = changePct(totalRevenue, prevRevenue);\n diffs.totalProfit = changePct(totalProfit, prevProfit);\n diffs.avgPrice = changePct(avgPrice, prevAvgPrice);\n diffs.sellThroughRate = changePct(sellThroughRate, prevSellThrough);\n diffs.totalPromoCost = changePct(totalPromoCost, prevPromoCost);\n diffs.totalRefundAmount = changePct(totalRefundAmount, prevRefundAmount);\n diffs.profitPerOrder = prevOrders > 0 ? changePct(totalProfit / totalOrders, prevProfit / prevOrders) : null;\n } else {\n diffs.productCount = null; diffs.totalGmv = null; diffs.totalRevenue = null;\n diffs.totalProfit = null; diffs.avgPrice = null; diffs.sellThroughRate = null;\n diffs.totalPromoCost = null; diffs.totalRefundAmount = null; diffs.profitPerOrder = null;\n }\n return { productCount: productIds.size, totalSales, totalRevenue, totalProfit, totalGmv, avgPrice, afterSaleRate, zeroSales, lowInventory, sellThroughRate, avgTurnover, avgPromoRatio, refundRate, totalOrders, totalPromoCost, totalPromoClicks, totalRefundAmount, diffs };\n }, [filteredProducts, prevProducts]);\n\n const radarData = useMemo(() => {\n if (!selectedProduct) return [];\n const p = products.find(x => x.id === selectedProduct);\n if (!p) return [];\n return [\n { subject: '销量', A: Math.min(100, p.sales / 10), fullMark: 100 },\n { subject: '收入', A: Math.min(100, p.revenue / 100), fullMark: 100 },\n { subject: '利润', A: Math.min(100, p.profit / 50), fullMark: 100 },\n { subject: '售后率', A: 100 - p.afterSaleRate, fullMark: 100 },\n { subject: '动销', A: p.sales > 0 ? 100 : 0, fullMark: 100 },\n ];\n }, [selectedProduct, products]);\n\n // 选中商品的订单明细（融合订单级数据）\n const selectedProductOrders = useMemo(() => {\n if (!selectedProduct) return [];\n return filteredOrders.filter(o => {\n const pid = String(findField(o, '商品ID', '商品编号') || '').trim();\n return pid === selectedProduct;\n });\n }, [selectedProduct, filteredOrders]);\n\n\n const priceElasticity = useMemo(() => {\n if (!filteredProducts.length) return [];\n const data = filteredProducts.slice(0, 30).map(p => ({\n price: p.avgPrice, sales: p.sales, name: p.name.slice(0, 10), profit: p.profit, discountRatio: p.discountRatio, profitRate: p.profitRate\n }));\n // 价格带分层统计\n const bands: Record<string, { min: number; max: number; count: number; totalSales: number; totalProfit: number; avgProfitRate: number }> = {};\n data.forEach(p => {\n const bandKey = p.price < 20 ? '¥0-20' : p.price < 50 ? '¥20-50' : p.price < 100 ? '¥50-100' : p.price < 200 ? '¥100-200' : '¥200+';\n const band = bands[bandKey] || (bands[bandKey] = { min: 0, max: 0, count: 0, totalSales: 0, totalProfit: 0, avgProfitRate: 0 });\n band.count++;\n band.totalSales += p.sales;\n band.totalProfit += p.profit;\n const [lo, hi] = bandKey.replace('¥', '').replace('+', '-99999').split('-').map(Number);\n band.min = lo;\n band.max = hi === 99999 ? Infinity : hi;\n });\n Object.values(bands).forEach(b => { b.avgProfitRate = b.totalSales > 0 ? (b.totalProfit / b.totalSales) * 100 : 0; });\n return { scatter: data, bands: Object.entries(bands).map(([k, v]) => ({ label: k, ...v })).sort((a, b) => a.min - b.min) };\n }, [filteredProducts]);\n\n // 价格历史（选定商品的每日价格变化）\n const priceHistory = useMemo(() => {\n if (!focusedPriceProductId || !filteredOrders.length) return [];\n const orderMap: Record<string, { date: string; totalPrice: number; orderCount: number; revenue: number; profit: number; sales: number }> = {};\n filteredOrders.forEach(o => {\n const pid = String(findField(o, '商品ID', '商品编号') || '').trim();\n if (pid !== focusedPriceProductId) return;\n const d = String(findField(o, '支付时间', '下单时间') || '').slice(0, 10);\n if (!d || !/^\\d{4}-\\d{2}-\\d{2}$/.test(d)) return;\n const tp = safeFloat(findField(o, '商品总价(元)'));\n const r = safeFloat(findField(o, '商家实收金额(元)'));\n const qty = safeFloat(findField(o, '商品数量(件)'));\n if (!orderMap[d]) orderMap[d] = { date: d, totalPrice: 0, orderCount: 0, revenue: 0, profit: 0, sales: 0 };\n orderMap[d].totalPrice = (orderMap[d].totalPrice * orderMap[d].orderCount + tp) / (orderMap[d].orderCount + 1); // 均价\n orderMap[d].orderCount++;\n orderMap[d].revenue += r;\n orderMap[d].sales += qty;\n });\n // 推算利润（简易：实收×平均利润率）\n const sp = focusedPriceProductId ? productStats[focusedPriceProductId] : null;\n const avgProfitRate = sp ? (sp.netProfit / (sp.revenue || 1)) : 0;\n return Object.values(orderMap).sort((a, b) => a.date.localeCompare(b.date)).slice(-30).map(d => ({\n ...d,\n profit: d.revenue * avgProfitRate,\n }));\n }, [focusedPriceProductId, filteredOrders, productStats]);\n\n const compareData = useMemo(() => products.filter(p => compareProducts.includes(p.id)), [compareProducts, products]);\n\n const toggleCompare = (id: string) => {\n setCompareProducts(prev => prev.includes(id) ? prev.filter(x => x !== id) : prev.length < 5 ? [...prev, id] : prev);\n };\n\n const addTag = (productId: string) => {\n if (!tagInput.trim()) return;\n setProductTags(prev => ({ ...prev, [productId]: [...(prev[productId] || []), tagInput.trim()] }));\n setTagInput('');\n setTaggingProduct(null);\n };\n\n const removeTag = (productId: string, tag: string) => {\n setProductTags(prev => ({ ...prev, [productId]: (prev[productId] || []).filter(t => t !== tag) }));\n };\n\n const noData = !filteredOrders.length;\n const rangeLabel = timeRange === '7' ? '近7天' : timeRange === '30' ? '近30天' : '近90天';\n\n // ★ 全量日趋势数据（支持12个KPI全部折线）\n const dailyKpiData = useMemo(() => {\n const m: Record<string,any> = {};\n filteredOrders.forEach(o => {\n const d = String(findField(o,'支付时间','下单时间')||'').slice(0,10);\n if (!d||!/^\\d{4}-\\d{2}-\\d{2}$/.test(d)) return;\n if (!m[d]) m[d] = {date:d,gmv:0,revenue:0,paid:0,profit:0,orders:0,qty:0,refund:0,discount:0,productSet:new Set(),buyerSet:new Set()};\n const g = safeFloat(findField(o,'商品总价(元)'));\n const r = safeFloat(findField(o,'商家实收金额(元)'));\n const p = safeFloat(findField(o,'用户实付金额(元)'));\n const ref = String(findField(o,'售后状态')||'').includes('退款成功') ? r : 0;\n const disc = safeFloat(findField(o,'店铺优惠折扣(元)')) + safeFloat(findField(o,'平台优惠折扣(元)')) + safeFloat(findField(o,'多多支付立减金额(元)'));\n const q = safeFloat(findField(o,'商品数量(件)'));\n m[d].gmv += g; m[d].revenue += r; m[d].paid += p; m[d].qty += q; m[d].orders++;\n m[d].refund += ref; m[d].discount += disc; m[d].profit += r - ref;\n const pid = String(findField(o,'商品ID','商品id')||'').trim();\n if (pid) m[d].productSet.add(pid);\n const on = String(findField(o,'订单号')||'').trim();\n if (on) m[d].buyerSet.add(on.slice(-4));\n });\n const arr = Object.values(m).sort((a:any,b:any)=>a.date.localeCompare(b.date));\n // 计算7日均值等衍生指标\n arr.forEach((d:any,i:number) => {\n const prev7 = arr.slice(Math.max(0,i-6),i+1);\n d.avgPrice = d.orders > 0 ? d.paid / d.orders : 0;\n d.refundAmount = d.refund;\n d.sellThrough = d.productSet.size;\n d.turnover = d.orders;\n d.promoRatio = d.gmv > 0 ? (d.discount/d.gmv)*100 : 0;\n d.asRate = d.orders > 0 ? (d.refund>0?d.orders*0.15:0) : 0;\n d.rfRate = d.orders > 0 ? (d.refund>0?100*d.orders/prev7.reduce((s:number,x:any)=>s+x.orders,0):0) : 0;\n d.productCount = d.productSet.size;\n d.zeroSales = 0;\n d.lowInventory = 0;\n // 精简对象\n delete d.productSet; delete d.buyerSet;\n });\n return arr;\n }, [filteredOrders]);\n\n // ★ 全量KPI映射（12个KPI全部可切换折线）\n const kpiKeyMap: Record<string, string> = {\n '总GMV': 'gmv', '总实收': 'revenue', '总利润': 'profit',\n '客单价': 'avgPrice', '动销率': 'sellThrough', '均周转天数': 'turnover',\n '推广占比': 'promoRatio', '售后率': 'asRate', '退款率': 'rfRate',\n '在售商品': 'productCount', '零动销': 'zeroSales', '库存预警': 'lowInventory',\n };\n const handleKpiClick = (label: string) => {\n const key = kpiKeyMap[label];\n if (key) {\n setSelectedTrendKpis(prev => {\n const next = new Set(prev);\n if (next.has(key)) {\n // 至少保留一条线，不允许全关\n if (next.size <= 1) return next;\n next.delete(key);\n } else next.add(key);\n return next;\n });\n }\n };\n\n const handleKpiDetailClick = (label: string) => {\n const data = filteredProducts.sort((a:any,b:any)=>b.gmv-a.gmv).slice(0,30).map(p => ({\n '商品': p.name||p.id,'GMV': p.gmv.toFixed(0),'利润': p.profit.toFixed(0),'销量': String(p.sales||0),'退款率': p.refundRate.toFixed(1)+'%'\n }));\n setDetailModal({open:true,title:label+' · 商品明细',data,columns:[{key:'商品',label:'商品名称'},{key:'GMV',label:'GMV(元)'},{key:'利润',label:'利润(元)'},{key:'销量',label:'销量(件)'},{key:'退款率',label:'退款率(%)'}]});\n };\n\n // 导出 CSV\n const handleExportCSV = () => {\n const headers = ['商品名称', '商品ID', '商家编码', 'GMV', '实收', '利润', '利润率(%)', '推广花费', '推广成交', '推广ROI', '退款率(%)', '售后率(%)'];\n const rows = filteredProducts.map(p => [\n p.name, p.id, p.code,\n p.gmv.toFixed(0), p.revenue.toFixed(0), p.profit.toFixed(0), p.profitRate.toFixed(1),\n p.promoCost > 0 ? p.promoCost.toFixed(0) : '0',\n p.promoTransaction > 0 ? p.promoTransaction.toFixed(0) : '0',\n p.promoCost > 0 && p.promoTransaction > 0 ? (p.promoTransaction / p.promoCost).toFixed(2) : '-',\n p.refundRate > 0 ? p.refundRate.toFixed(1) : '0',\n p.afterSaleRate.toFixed(1),\n ]);\n const csv = '﻿' + headers.join(',') + '\\n' + rows.map(r => r.join(',')).join('\\n');\n const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });\n const url = URL.createObjectURL(blob);\n const a = document.createElement('a');\n a.href = url;\n a.download = `商品分析_导出_${new Date().toISOString().slice(0, 10)}.csv`;\n a.click();\n URL.revokeObjectURL(url);\n };\n\n // Smart alert tags\n const getAlertTags = (p: any) => {\n const tags: { label: string; variant: string }[] = [];\n if (p.refundRate > 15) tags.push({ label: '高退款', variant: 'destructive' });\n if (p.sales <= 0) tags.push({ label: '零动销', variant: 'secondary' });\n if (p.inventoryStatus === 'low') tags.push({ label: '低库存', variant: 'warning' });\n if (p.promoCostRatio > 30) tags.push({ label: '高推广依赖', variant: 'default' });\n if (p.turnoverDays > 60 && p.turnoverDays < 999) tags.push({ label: '周转慢', variant: 'warning' });\n return tags;\n };\n\n // 计算总利润可信度（基于商品利润可信度的加权平均）\n const totalProfitConfidence = useMemo(() => {\n if (!filteredProducts.length) return 'low';\n const profits = filteredProducts.map(p => p.profit || 0);\n const totalProfit = profits.reduce((s, p) => s + p, 0);\n if (totalProfit === 0) return 'low';\n\n // 根据利润贡献加权计算可信度\n let highWeight = 0, mediumWeight = 0, lowWeight = 0;\n filteredProducts.forEach(p => {\n const weight = Math.abs(p.profit || 0) / totalProfit;\n const confidence = p.profitConfidence || 'low';\n if (confidence === 'high') highWeight += weight;\n else if (confidence === 'medium') mediumWeight += weight;\n else lowWeight += weight;\n });\n\n if (highWeight > 0.5) return 'high';\n if (mediumWeight > 0.3 || highWeight > 0.3) return 'medium';\n return 'low';\n }, [filteredProducts]);\n\n const rawKpiCards = [\n { label: '总GMV', value: kpiMetrics?.totalGmv, diffKey: 'totalGmv' as const, fmt: (v: number) => `¥${(v/10000).toFixed(1)}万`, icon: ShoppingCart, color: CHART.primary[0], bg: 'bg-blue-50' },\n { label: '总实收', value: kpiMetrics?.totalRevenue, diffKey: 'totalRevenue' as const, fmt: (v: number) => `¥${(v/10000).toFixed(1)}万`, icon: DollarSign, color: SEMANTIC.profit, bg: 'bg-green-50' },\n { label: '总利润', value: kpiMetrics?.totalProfit, diffKey: 'totalProfit' as const, fmt: (v: number) => `¥${(v/10000).toFixed(1)}万`, icon: TrendingUp, color: CHART.primary[4], bg: 'bg-purple-50', confidence: totalProfitConfidence },\n { label: '客单价', value: kpiMetrics?.avgPrice, diffKey: 'avgPrice' as const, fmt: (v: number) => `¥${v.toFixed(2)}`, icon: Target, color: SEMANTIC.warning, bg: 'bg-amber-50' },\n { label: '在售商品', value: kpiMetrics?.productCount, diffKey: 'productCount' as const, fmt: (v: number) => v.toFixed(0), icon: Package, color: CHART.primary[0], bg: 'bg-blue-50' },\n { label: '动销率', value: kpiMetrics?.sellThroughRate, diffKey: 'sellThroughRate' as const, fmt: (v: number) => `${v.toFixed(1)}%`, icon: Activity, color: CHART.extended[0], bg: 'bg-cyan-50' },\n { label: '推广占比', value: kpiMetrics?.avgPromoRatio, fmt: (v: number) => `${v.toFixed(1)}%`, icon: Zap, color: CHART.primary[4], bg: 'bg-purple-50' },\n { label: '售后率', value: kpiMetrics?.afterSaleRate, fmt: (v: number) => `${v.toFixed(1)}%`, icon: AlertTriangle, color: SEMANTIC.warning, bg: 'bg-amber-50' },\n { label: '退款率', value: kpiMetrics?.refundRate, fmt: (v: number) => `${v.toFixed(1)}%`, icon: RotateCcw, color: SEMANTIC.loss, bg: 'bg-red-50' },\n { label: '平台技术服务费', value: kpiMetrics?.totalRevenue != null ? ((platformCommissionRate || 0) * kpiMetrics.totalRevenue) : undefined, fmt: (v: number) => `¥${v.toFixed(0)}`, icon: Percent, color: SEMANTIC.info, bg: 'bg-blue-50' },\n { label: '单均利润', value: kpiMetrics?.totalOrders && kpiMetrics.totalOrders > 0 && kpiMetrics?.totalProfit != null ? kpiMetrics.totalProfit / kpiMetrics.totalOrders : undefined, diffKey: 'profitPerOrder' as const, fmt: (v: number) => `¥${v.toFixed(2)}`, icon: Target, color: SEMANTIC.profit, bg: 'bg-green-50' },\n { label: 'CPC', value: kpiMetrics?.totalPromoClicks && kpiMetrics.totalPromoClicks > 0 && kpiMetrics?.totalPromoCost != null ? kpiMetrics.totalPromoCost / kpiMetrics.totalPromoClicks : undefined, fmt: (v: number) => `¥${v.toFixed(2)}`, icon: Zap, color: '#eb2f96', bg: 'bg-pink-50' },\n { label: '运费险', value: kpiMetrics?.totalOrders != null ? ((insuranceFeePerOrder || 0) * kpiMetrics.totalOrders) : undefined, fmt: (v: number) => `¥${v.toFixed(0)}`, icon: DollarSign, color: CHART.extended[0], bg: 'bg-cyan-50' },\n { label: '快递费', value: kpiMetrics?.totalOrders != null ? ((shippingFeePerOrder || 0) * kpiMetrics.totalOrders) : undefined, fmt: (v: number) => `¥${v.toFixed(0)}`, icon: Truck, color: CHART.extended[1], bg: 'bg-orange-50' },\n { label: '包装费', value: kpiMetrics?.totalOrders != null ? ((packagingFeePerOrder || 0) * kpiMetrics.totalOrders) : undefined, fmt: (v: number) => `¥${v.toFixed(0)}`, icon: Box, color: '#84CC16', bg: 'bg-lime-50' },\n { label: '商品总成本', value: Object.values(productCosts || {}).reduce((s: number, c: any) => s + (c.productCost || 0), 0) * (kpiMetrics?.productCount || 0), fmt: (v: number) => `¥${(v/10000).toFixed(1)}万`, icon: DollarSign, color: SEMANTIC.loss, bg: 'bg-red-50' },\n { label: '均周转天数', value: kpiMetrics?.avgTurnover, fmt: (v: number) => `${v.toFixed(0)}天`, icon: Clock, color: CHART.extended[1], bg: 'bg-orange-50' },\n { label: '零动销', value: kpiMetrics?.zeroSales, fmt: (v: number) => v.toFixed(0), icon: Ban, color: SEMANTIC.neutral, bg: 'bg-gray-50' },\n { label: '库存预警', value: kpiMetrics?.lowInventory, fmt: (v: number) => v.toFixed(0), icon: Box, color: SEMANTIC.warning, bg: 'bg-amber-50' },\n ];\n // ★ 按保存的排序重排\n const kpiCards = useMemo(() => {\n if (!kpiCardOrder.length) return rawKpiCards;\n const orderMap = new Map(kpiCardOrder.map((l, i) => [l, i]));\n return [...rawKpiCards].sort((a, b) => (orderMap.get(a.label) ?? 999) - (orderMap.get(b.label) ?? 999));\n }, [rawKpiCards, kpiCardOrder]);\n\n // ─── KPI 卡片（5个核心指标，和数据中心风格一致）────\n const renderKpiCards = () => {\n if (noData) return null;\n const cards = [\n { label: '总GMV', val: kpiMetrics?.totalGmv, fmt: (v: number) => `¥${(v/10000).toFixed(1)}万`, icon: ShoppingCart, change: kpiMetrics?.diffs?.totalGmv ?? null, color: '' },\n { label: '总利润', val: kpiMetrics?.totalProfit, fmt: (v: number) => `¥${(v/10000).toFixed(1)}万`, icon: TrendingUp, change: kpiMetrics?.diffs?.totalProfit ?? null, color: kpiMetrics?.totalProfit != null && kpiMetrics.totalProfit >= 0 ? SEMANTIC.profit : SEMANTIC.loss },\n { label: '退款率', val: kpiMetrics?.refundRate, fmt: (v: number) => `${v.toFixed(1)}%`, icon: RotateCcw, change: null, color: kpiMetrics?.refundRate != null && kpiMetrics.refundRate > 15 ? SEMANTIC.loss : '' },\n { label: '推广ROI', val: kpiMetrics?.totalPromoCost > 0 && kpiMetrics?.totalGmv ? kpiMetrics.totalGmv / kpiMetrics.totalPromoCost : 0, fmt: (v: number) => v.toFixed(2), icon: Target, change: null, color: '' },\n { label: '客单价', val: kpiMetrics?.avgPrice, fmt: (v: number) => `¥${v.toFixed(0)}`, icon: DollarSign, change: kpiMetrics?.diffs?.avgPrice ?? null, color: '' },\n ];\n return (\n <div className=\"grid grid-cols-5 gap-3 px-4 py-3\">\n {cards.map(c => (\n <div key={c.label} className=\"bg-pdd-card rounded-lg border border-pdd-border/60 px-4 py-3\">\n <div className=\"flex items-center gap-1.5 mb-0.5\">\n <c.icon size={13} className=\"text-pdd-text-secondary\" />\n <span className=\"text-[11px] font-medium text-pdd-text-secondary/80\">{c.label}</span>\n </div>\n <div className=\"flex items-baseline gap-1.5\">\n <span className=\"text-xl font-semibold tabular-nums tracking-tight\" style={{ color: c.color || 'var(--pdd-text)' }}>\n {c.val != null ? c.fmt(c.val) : '/'}\n </span>\n {c.change != null && Math.abs(c.change) > 0.01 && (\n <span className={`text-[11px] ${c.change > 0 ? 'text-pdd-success' : 'text-pdd-danger'}`}>\n {c.change > 0 ? <ArrowUp size={10} className=\"inline\" /> : <ArrowDown size={10} className=\"inline\" />}\n {Math.abs(c.change).toFixed(1)}%\n </span>\n )}\n </div>\n </div>\n ))}\n </div>\n );\n };\n\n // ─── 右侧详情面板 ──────────────────────────────\n const renderDetailPanel = (sp: ProductStat) => {\n const trend7 = dailyKpiData.slice(-7);\n const alerts = [\n sp.refundRate > 15 ? '高退款' : null,\n (sp.avgDailySales ?? 0) <= 0 ? '零动销' : null,\n (sp.avgDailySales ?? 0) < 2 && (sp.avgDailySales ?? 0) > 0 ? '低库存' : null,\n (sp.promoCostRatio ?? 0) > 30 ? '高推广依赖' : null,\n (sp.turnoverDays ?? 0) > 60 && (sp.turnoverDays ?? 0) < 999 ? '周转慢' : null,\n ].filter(Boolean);\n return (\n <div className=\"h-full flex flex-col border-l border-pdd-border/20 bg-pdd-card\">\n <div className=\"px-4 py-3 border-b border-pdd-border/10 flex items-center justify-between\">\n <div className=\"min-w-0 flex-1\">\n <div className=\"flex items-center gap-2\">\n <h2 className=\"text-sm font-semibold text-pdd-text truncate\">{sp.productName}</h2>\n {alerts.length > 0 && alerts.slice(0, 2).map(a => (\n <span key={a} className=\"text-[9px] px-1 py-0.5 rounded bg-pdd-danger/8 text-pdd-danger font-medium shrink-0\">{a}</span>\n ))}\n </div>\n <span className=\"text-[9px] text-pdd-text-secondary/30 font-mono\">{sp.productId}</span>\n </div>\n <button onClick={() => { setSelectedProduct(null); setCurrentPage(1); }}\n className=\"text-pdd-text-secondary/30 hover:text-pdd-text transition-colors ml-2\">\n <X size={14} />\n </button>\n </div>\n <div className=\"px-4 py-3 grid grid-cols-3 gap-2\">\n {[\n { label: 'GMV', val: sp.gmv, fmt: (v: number) => `¥${(v/1000).toFixed(1)}k`, color: '' },\n { label: '利润', val: sp.netProfit, fmt: (v: number) => `¥${v.toFixed(0)}`, color: sp.netProfit >= 0 ? SEMANTIC.profit : SEMANTIC.loss },\n { label: 'ROI', val: sp.roi || 0, fmt: (v: number) => v.toFixed(2), color: '' },\n { label: '退款率', val: sp.refundRate, fmt: (v: number) => `${v.toFixed(1)}%`, color: sp.refundRate > 15 ? SEMANTIC.loss : '' },\n { label: '销量', val: sp.sales, fmt: (v: number) => v.toFixed(0), color: '' },\n { label: '客单价', val: sp.avgOrderValue, fmt: (v: number) => `¥${v.toFixed(0)}`, color: '' },\n { label: '利润率', val: sp.profitRate, fmt: (v: number) => `${v.toFixed(1)}%`, color: sp.profitRate >= 0 ? SEMANTIC.profit : SEMANTIC.loss },\n { label: '推广费', val: sp.promoCost, fmt: (v: number) => `¥${v.toFixed(0)}`, color: '' },\n { label: '售后率', val: sp.afterSaleRate, fmt: (v: number) => `${v.toFixed(1)}%`, color: sp.afterSaleRate > 15 ? SEMANTIC.loss : '' },\n ].map(m => (\n <div key={m.label} className=\"bg-pdd-bg/40 rounded px-2 py-1.5\">\n <div className=\"text-[8px] text-pdd-text-secondary/40 font-medium mb-0.5\">{m.label}</div>\n <div className=\"text-xs font-semibold tabular-nums leading-tight\" style={{ color: m.color || 'var(--pdd-text)' }}>{m.fmt(m.val)}</div>\n </div>\n ))}\n </div>\n {trend7.length > 1 && (\n <div className=\"px-4 pb-3\">\n <div className=\"text-[8px] text-pdd-text-secondary/40 font-medium mb-1\">7日趋势</div>\n <ResponsiveContainer width=\"100%\" height={50}>\n <LineChart data={trend7}>\n <Line type=\"monotone\" dataKey=\"gmv\" stroke={CHART.primary[0]} strokeWidth={1.5} dot={false} isAnimationActive={false} />\n <Line type=\"monotone\" dataKey=\"profit\" stroke={SEMANTIC.profit} strokeWidth={1.5} dot={false} isAnimationActive={false} />\n </LineChart>\n </ResponsiveContainer>\n </div>\n )}\n <div className=\"mt-auto px-4 py-3 border-t border-pdd-border/10 flex items-center gap-2\">\n <button onClick={() => { setDeepAnalysisProductId(sp.productId); setDeepAnalysisOpen(true); }}\n className=\"flex-1 text-[10px] h-7 rounded border border-pdd-border/30 text-pdd-text-secondary hover:bg-pdd-bg transition-colors\">深度分析</button>\n <button onClick={() => { setActiveView('price'); setFocusedPriceProductId(sp.productId); }}\n className=\"flex-1 text-[10px] h-7 rounded border border-pdd-border/30 text-pdd-text-secondary hover:bg-pdd-bg transition-colors\">定价分析</button>\n </div>\n </div>\n );\n };\n\n // ─── 商品列表视图 ──────────────────────────────\n const renderProductList = () => {\n return (\n <div>\n <div className=\"px-4 py-2 flex items-center gap-2\">\n <div className=\"relative flex-1 max-w-[220px]\">\n <input type=\"text\" placeholder=\"搜索 ID / 名称 / 编码...\"\n value={searchKeyword}\n onChange={(e) => { setSearchKeyword(e.target.value); setCurrentPage(1); }}\n className=\"w-full h-7 text-xs pl-7 pr-5 rounded border border-pdd-border/15 bg-transparent text-pdd-text outline-none focus:border-pdd-text-secondary/30 transition-colors placeholder:text-pdd-text-secondary/20\" />\n <Search size={11} className=\"absolute left-2 top-1/2 -translate-y-1/2 text-pdd-text-secondary/20\" />\n {searchKeyword && (\n <button onClick={() => { setSearchKeyword(''); setCurrentPage(1); }}\n className=\"absolute right-1.5 top-1/2 -translate-y-1/2 text-pdd-text-secondary/20 hover:text-pdd-text transition-colors\"><X size={10} /></button>\n )}\n </div>\n <span className=\"text-[10px] text-pdd-text-secondary/25\">{filteredProducts.length} 款</span>\n <div className=\"flex-1\" />\n {!noData && (\n <button onClick={handleExportCSV}\n className=\"text-[10px] text-pdd-text-secondary/25 hover:text-pdd-text-secondary transition-colors flex items-center gap-1\">\n <Download size={10} />导出\n </button>\n )}\n <div className=\"flex items-center gap-1\">\n <button onClick={() => setCurrentPage(Math.max(1, currentPage - 1))} disabled={currentPage === 1}\n className=\"h-5 w-5 flex items-center justify-center rounded text-pdd-text-secondary/20 hover:text-pdd-text hover:bg-pdd-bg disabled:opacity-20 transition-colors\">\n <ChevronLeft size={11} />\n </button>\n <span className=\"text-[9px] text-pdd-text-secondary/25 tabular-nums min-w-[1.5rem] text-center\">{currentPage}/{totalPages || 1}</span>\n <button onClick={() => setCurrentPage(Math.min(totalPages, currentPage + 1))} disabled={currentPage === totalPages}\n className=\"h-5 w-5 flex items-center justify-center rounded text-pdd-text-secondary/20 hover:text-pdd-text hover:bg-pdd-bg disabled:opacity-20 transition-colors\">\n <ChevronRight size={11} />\n </button>\n </div>\n </div>\n <div className=\"px-4 py-1 flex items-center gap-2 text-[8px] text-pdd-text-secondary/15 font-medium uppercase tracking-widest border-b border-pdd-border/5\">\n <span className=\"w-1\" />\n <span className=\"flex-1\">商品</span>\n <span className=\"w-20 text-right\">GMV</span>\n <span className=\"w-16 text-right\">利润</span>\n <span className=\"w-12 text-right\">ROI</span>\n <span className=\"w-10 text-right\">退款</span>\n </div>\n {noData ? (\n <div className=\"h-40 flex flex-col items-center justify-center text-xs text-pdd-text-secondary/20 gap-1\">\n <span>暂无数据</span>\n </div>\n ) : paginatedProducts.length > 0 ? (\n <div>\n {paginatedProducts.map((p, i) => {\n const alerts = getAlertTags(p);\n const isSelected = selectedProduct === p.id;\n return (\n <div key={p.id}\n onClick={() => setSelectedProduct(p.id)}\n className={`flex items-center gap-2 px-4 py-2 cursor-pointer transition-all duration-100 ${isSelected ? \"bg-pdd-primary/4\" : \"hover:bg-pdd-bg/30\"} ${i > 0 ? \"border-t border-pdd-border/5\" : \"\"}`}>\n <span className={`w-1 h-1 rounded-full shrink-0 ${alerts.length > 0 ? \"bg-pdd-danger\" : \"bg-transparent\"}`} />\n <div className=\"flex-1 min-w-0 flex items-baseline gap-1.5\">\n <span className=\"text-xs text-pdd-text truncate\">{p.name}</span>\n <span className=\"text-[8px] text-pdd-text-secondary/15 font-mono shrink-0\">{p.id}</span>\n </div>\n <span className=\"text-xs tabular-nums w-20 text-right text-pdd-text\">¥{(salesMetric === \"gmv\" ? p.gmv : p.revenue).toFixed(0)}</span>\n <span className=\"text-xs tabular-nums w-16 text-right\" style={{ color: p.profit >= 0 ? \"var(--pdd-text)\" : SEMANTIC.loss }}>{p.profit >= 0 ? \"¥\" + p.profit.toFixed(0) : \"-¥\" + Math.abs(p.profit).toFixed(0)}</span>\n <span className=\"text-[10px] tabular-nums w-12 text-right text-pdd-text-secondary/25\">{p.roi > 0 ? p.roi.toFixed(1) : \"-\"}</span>\n <span className={`text-[10px] tabular-nums w-10 text-right ${p.refundRate > 15 ? \"text-pdd-danger\" : \"text-pdd-text-secondary/15\"}`}>{p.refundRate.toFixed(0)}%</span>\n </div>\n );\n })}\n </div>\n ) : (\n <div className=\"h-24 flex items-center justify-center\">\n <span className=\"text-xs text-pdd-text-secondary/15\">无匹配商品</span>\n </div>\n )}\n </div>\n );\n };\n const renderPricePanel = () => {\n const { scatter, bands } = priceElasticity as { scatter: any[]; bands: any[] };\n const focusedProduct = focusedPriceProductId ? products.find(p => p.id === focusedPriceProductId) : null;\n // 计算器参数（从现有配置读取）\n const calcCost = focusedProduct?.costBreakdown?.productCost || defaultCostRatio || 8;\n const calcShipping = shippingFeePerOrder || 3.5;\n const calcPlatform = platformCommissionRate || 0.01;\n const calcInsurance = insuranceFeePerOrder || 0.9;\n // 计算结果\n const calcRevenue = calcPrice;\n const calcCostTotal = calcCost + calcShipping + calcRevenue * calcPlatform + calcInsurance;\n const calcProfit = calcRevenue - calcCostTotal;\n const calcProfitRate = calcRevenue > 0 ? (calcProfit / calcRevenue) * 100 : 0;\n const calcBreakevenRoi = calcRevenue > 0 ? calcRevenue / (calcCostTotal || 1) : 0;\n // 多数量试算\n const multiQtyTrial = [1, 2, 3, 5, 10].map(qty => {\n const rev = calcPrice * qty;\n const cost = (calcCost + calcShipping + calcInsurance) * qty + calcPrice * qty * calcPlatform;\n return { qty, rev, cost, profit: rev - cost };\n });\n return (\n <div className=\"space-y-4\">\n {/* █ 区块① 全店价格总览 */}\n <Card>\n \n \n <CardHeader className=\"px-4 py-3 border-b border-pdd-border/40 border-pdd-border/30\">\n <CardTitle className=\"text-sm flex items-center gap-1.5\"><div className=\"w-4 h-4 rounded flex items-center justify-center\"><Zap size={10} className=\"text-white\" /></div><span >全店价格总览</span></CardTitle>\n </CardHeader>\n {noData ? <CardContent><div className=\"h-40 flex items-center justify-center text-xs text-pdd-text-secondary\">请先上传数据</div></CardContent> : (\n <CardContent className=\"p-3 space-y-4\">\n {/* 价格带分布 */}\n {bands.length > 0 && (\n <div>\n <h4 className=\"text-xs font-semibold text-pdd-text mb-2 flex items-center gap-1\"><BarChart3 size={12} className=\"text-pdd-primary\" />价格带销售分布</h4>\n <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\n <ResponsiveContainer width=\"100%\" height={180}>\n <BarChart data={bands}>\n <CartesianGrid strokeDasharray=\"3 3\" stroke=\"var(--pdd-border)\" vertical={false} />\n <XAxis dataKey=\"label\" tick={{ fontSize: 9, fill: 'var(--pdd-text-secondary)' }} axisLine={false} tickLine={false} />\n <YAxis tick={{ fontSize: 9, fill: 'var(--pdd-text-secondary)' }} axisLine={false} tickLine={false} />\n <Tooltip contentStyle={{ borderRadius: '8px', border: 'none', boxShadow: '0 4px 12px rgba(0,0,0,0.1)', fontSize: '11px' }} formatter={(v: number, n: string) => [n === 'count' ? `${v}款` : `${v}件`, n === 'count' ? '商品数' : '销量']} />\n <Bar dataKey=\"count\" name=\"商品数\" fill={CHART.all[0]} radius={[4, 4, 0, 0]} barSize={24} />\n </BarChart>\n </ResponsiveContainer>\n <div className=\"space-y-1.5\">\n {bands.map((b: any) => (\n <div key={b.label} className=\"flex items-center gap-2 text-xs\">\n <span className=\"w-16 text-pdd-text-secondary font-mono text-[10px]\">{b.label}</span>\n <span className=\"flex-1 text-pdd-text\">{b.count}款</span>\n <span className=\"text-pdd-text tabular-nums\">{b.totalSales}件</span>\n <span className=\"w-16 text-right tabular-nums\" style={{ color: b.avgProfitRate >= 0 ? SEMANTIC.profit : SEMANTIC.loss }}>{b.avgProfitRate.toFixed(1)}%</span>\n </div>\n ))}\n </div>\n </div>\n </div>\n )}\n {/* 价格-销量散点图（可点击聚焦） */}\n <div>\n <h4 className=\"text-xs font-semibold text-pdd-text mb-2 flex items-center gap-1\"><Activity size={12} color={CHART.all[4]} />价格-销量关系\n {focusedPriceProductId && <button onClick={() => setFocusedPriceProductId(null)} className=\"ml-2 text-[9px] text-pdd-text-secondary/50 hover:text-pdd-danger\">✕ 清除聚焦</button>}\n </h4>\n <ResponsiveContainer width=\"100%\" height={220}>\n <ScatterChart>\n <CartesianGrid strokeDasharray=\"3 3\" stroke=\"var(--pdd-border)\" />\n <XAxis type=\"number\" dataKey=\"price\" name=\"客单价\" tick={{ fontSize: 10 }} unit=\"元\" />\n <YAxis type=\"number\" dataKey=\"sales\" name=\"销量\" tick={{ fontSize: 10 }} />\n <Tooltip cursor={{ strokeDasharray: '3 3' }} contentStyle={{ borderRadius: '8px', border: 'none', boxShadow: '0 4px 12px rgba(0,0,0,0.1)', fontSize: '11px' }}\n formatter={(v: number, n: string, p: any) => [v, p?.payload?.name || n]} />\n <Scatter data={scatter} fill={CHART.all[0]} onClick={(data: any) => {\n if (data?.payload) {\n const name = data.payload.name;\n const matched = products.find(p => p.name.startsWith(name) || name.startsWith(p.name));\n if (matched) setFocusedPriceProductId(matched.id);\n }\n }}>\n {scatter.map((entry: any, index: number) => {\n const isFocused = focusedProduct && (entry.name === focusedProduct.name || focusedProduct.name.startsWith(entry.name));\n return (\n <Cell key={`cell-${index}`}\n fill={isFocused ? '#ff4d4f' : entry.profit >= 0 ? SEMANTIC.profit : SEMANTIC.loss}\n fillOpacity={isFocused ? 1 : 0.6}\n stroke={isFocused ? '#ff4d4f' : 'none'}\n strokeWidth={isFocused ? 2 : 0}\n />\n );\n })}\n </Scatter>\n </ScatterChart>\n </ResponsiveContainer>\n <div className=\"flex items-center gap-4 text-[10px] text-pdd-text-secondary justify-center mt-1\">\n <span className=\"flex items-center gap-1\"><span className=\"w-2 h-2 rounded-full\" style={{ backgroundColor: SEMANTIC.profit }} />盈利</span>\n <span className=\"flex items-center gap-1\"><span className=\"w-2 h-2 rounded-full\" style={{ backgroundColor: SEMANTIC.loss }} />亏损</span>\n {focusedPriceProductId && <span className=\"flex items-center gap-1\"><span className=\"w-2 h-2 rounded-full bg-red-500\" />聚焦</span>}\n </div>\n </div>\n </CardContent>\n )}\n </Card>\n\n {/* █ 区块②+③ 价格历史 + 定价计算器（聚焦商品时显示） */}\n {focusedPriceProductId && focusedProduct && (\n <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-4\">\n {/* 价格历史辐射 */}\n <Card className=\"border-pdd-border/40 shadow-sm bg-pdd-card\">\n \n <CardHeader className=\"px-4 py-3 border-b border-pdd-border/40 border-pdd-border/30\">\n <CardTitle className=\"text-sm flex items-center gap-2\">\n <div className=\"w-4 h-4 rounded flex items-center justify-center\"><Activity size={10} className=\"text-white\" /></div>\n <span className=\"truncate font-semibold\">{focusedProduct.name}</span>\n <span className=\"text-[9px] font-mono text-pdd-text-secondary/50\">{focusedProduct.id}</span>\n </CardTitle>\n </CardHeader>\n <CardContent className=\"p-3\">\n {priceHistory.length === 0 ? (\n <div className=\"h-20 flex items-center justify-center text-xs text-pdd-text-secondary/50\">暂无历史价格数据</div>\n ) : (\n <>\n <table className=\"w-full text-[10px]\">\n <thead>\n <tr className=\"border-b border-pdd-border/30 text-pdd-text-secondary/50\">\n <th className=\"py-1.5 text-left\">日期</th>\n <th className=\"py-1.5 text-right\">单价</th>\n <th className=\"py-1.5 text-right\">日销</th>\n <th className=\"py-1.5 text-right\">利润</th>\n <th className=\"py-1.5 text-right w-10\"></th>\n </tr>\n </thead>\n <tbody>\n {priceHistory.slice(-10).map((d, i) => (\n <tr key={d.date}\n className=\"border-b border-pdd-border/20 hover:bg-blue-50/30 cursor-pointer transition-colors\"\n onClick={() => { setCalcPrice(Math.round(d.totalPrice * 10) / 10); }}>\n <td className=\"py-1.5 text-pdd-text-secondary/70\">{d.date.slice(5)}</td>\n <td className=\"py-1.5 text-right font-mono text-pdd-text\">¥{d.totalPrice.toFixed(1)}</td>\n <td className=\"py-1.5 text-right font-mono text-pdd-text\">{d.sales.toFixed(0)}</td>\n <td className=\"py-1.5 text-right font-mono\" style={{ color: d.profit >= 0 ? SEMANTIC.profit : SEMANTIC.loss }}>¥{d.profit.toFixed(0)}</td>\n <td className=\"py-1.5 text-right\"><span className=\"text-[8px] text-pdd-primary/60\">带入</span></td>\n </tr>\n ))}\n </tbody>\n </table>\n <p className=\"text-[9px] text-pdd-text-secondary/40 mt-2\">点击任一行 → 自动带入定价计算器</p>\n </>\n )}\n </CardContent>\n </Card>\n\n {/* 定价计算器 */}\n <Card className=\"border-pdd-border/40 shadow-sm bg-pdd-card\">\n \n \n <CardHeader className=\"px-4 py-3 border-b border-pdd-border/40 border-pdd-border/30\">\n <CardTitle className=\"text-sm flex items-center gap-1.5\"><div className=\"w-4 h-4 rounded flex items-center justify-center\"><Percent size={10} className=\"text-white\" /></div><span >定价计算器</span></CardTitle>\n </CardHeader>\n <CardContent className=\"p-3 space-y-3\">\n {/* 基础参数 */}\n <div>\n <h5 className=\"text-[10px] font-semibold text-pdd-text-secondary/60 mb-1.5\">基础参数</h5>\n <div className=\"flex items-center gap-2\">\n <span className=\"text-[10px] text-pdd-text-secondary/50 w-12\">试算价格</span>\n <div className=\"flex items-center gap-1\">\n <span className=\"text-[10px] text-pdd-text-secondary/50\">¥</span>\n <input type=\"number\" value={calcPrice} onChange={e => setCalcPrice(Number(e.target.value))}\n className=\"w-20 h-7 px-2 text-xs rounded border border-pdd-border bg-pdd-bg/50 text-pdd-text outline-none tabular-nums\" step=\"0.1\" />\n </div>\n </div>\n </div>\n {/* 成本因子 */}\n <div>\n <h5 className=\"text-[10px] font-semibold text-pdd-text-secondary/60 mb-1.5\">成本因子</h5>\n <div className=\"grid grid-cols-2 gap-x-4 gap-y-1 text-[10px]\">\n <div className=\"flex justify-between\"><span className=\"text-pdd-text-secondary/50\">商品成本</span><span className=\"tabular-nums\">¥{calcCost.toFixed(1)}</span></div>\n <div className=\"flex justify-between\"><span className=\"text-pdd-text-secondary/50\">运费</span><span className=\"tabular-nums\">¥{calcShipping.toFixed(1)}</span></div>\n <div className=\"flex justify-between\"><span className=\"text-pdd-text-secondary/50\">平台费率</span><span className=\"tabular-nums\">{(calcPlatform * 100).toFixed(1)}%</span></div>\n <div className=\"flex justify-between\"><span className=\"text-pdd-text-secondary/50\">运费险</span><span className=\"tabular-nums\">¥{calcInsurance.toFixed(1)}</span></div>\n </div>\n </div>\n {/* 计算结果 */}\n <div>\n <h5 className=\"text-[10px] font-semibold text-pdd-text-secondary/60 mb-1.5\">计算结果</h5>\n <div className=\"grid grid-cols-2 gap-x-4 gap-y-1.5 text-[10px] bg-pdd-bg/50 rounded-lg p-2\">\n <div>\n <span className=\"text-pdd-text-secondary/50\">成本合计</span>\n <div className=\"font-semibold tabular-nums\">¥{calcCostTotal.toFixed(1)}</div>\n </div>\n <div>\n <span className=\"text-pdd-text-secondary/50\">利润金额</span>\n <div className=\"font-semibold tabular-nums\" style={{ color: calcProfit >= 0 ? SEMANTIC.profit : SEMANTIC.loss }}>¥{calcProfit.toFixed(1)}</div>\n </div>\n <div>\n <span className=\"text-pdd-text-secondary/50\">利润率</span>\n <div className=\"font-semibold tabular-nums\" style={{ color: calcProfitRate >= 15 ? SEMANTIC.profit : calcProfitRate >= 0 ? SEMANTIC.warning : SEMANTIC.loss }}>{calcProfitRate.toFixed(1)}%</div>\n </div>\n <div>\n <span className=\"text-pdd-text-secondary/50\">保本ROI</span>\n <div className=\"font-semibold tabular-nums\">{calcBreakevenRoi.toFixed(2)}x</div>\n </div>\n </div>\n </div>\n {/* 多数量试算 */}\n <div>\n <h5 className=\"text-[10px] font-semibold text-pdd-text-secondary/60 mb-1.5\">多数量试算</h5>\n <div className=\"grid grid-cols-5 gap-1\">\n {multiQtyTrial.map(t => (\n <div key={t.qty} className=\"bg-pdd-bg/50 rounded p-1.5 text-center\">\n <div className=\"text-[9px] text-pdd-text-secondary/50\">{t.qty}件</div>\n <div className=\"text-[10px] font-semibold tabular-nums\" style={{ color: t.profit >= 0 ? SEMANTIC.profit : SEMANTIC.loss }}>¥{t.profit.toFixed(0)}</div>\n </div>\n ))}\n </div>\n </div>\n </CardContent>\n </Card>\n </div>\n )}\n\n {/* 折扣率分析（原有保留） */}\n {!noData && scatter.length > 0 && (\n <Card className=\"border-pdd-border/40 shadow-sm bg-pdd-card\">\n \n <CardHeader className=\"px-4 py-3 border-b border-pdd-border/40 border-pdd-border/30\">\n <CardTitle className=\"text-sm flex items-center gap-1.5\"><div className=\"w-4 h-4 rounded flex items-center justify-center\"><Percent size={10} className=\"text-white\" /></div><span >折扣率与利润关系</span></CardTitle>\n </CardHeader>\n <CardContent className=\"p-3\">\n <div className=\"max-h-[120px] overflow-y-auto space-y-1\">\n {[...scatter].sort((a: any, b: any) => b.discountRatio - a.discountRatio).slice(0, 10).map((p: any, i: number) => (\n <div key={i} className=\"flex items-center gap-2 text-xs py-1 px-2 bg-pdd-bg/50 rounded\">\n <span className=\"w-20 truncate text-pdd-text text-[10px]\" title={p.name}>{p.name}</span>\n <div className=\"flex-1 h-1.5 bg-pdd-border/30 rounded-full\">\n <div className=\"h-full rounded-full\" style={{ width: `${Math.min(100, p.discountRatio)}%`, backgroundColor: p.discountRatio > 20 ? SEMANTIC.loss : p.discountRatio > 10 ? SEMANTIC.warning : SEMANTIC.profit }} />\n </div>\n <span className=\"w-12 text-right font-mono text-[10px]\">{p.discountRatio.toFixed(1)}%</span>\n <span className=\"w-16 text-right tabular-nums text-[10px]\" style={{ color: p.profit >= 0 ? SEMANTIC.profit : SEMANTIC.loss }}>¥{p.profit.toFixed(0)}</span>\n </div>\n ))}\n </div>\n </CardContent>\n </Card>\n )}\n </div>\n );};\n\n return (\n <div className=\"min-h-screen bg-pdd-bg flex flex-col\">\n {/* Sticky header */}\n <div className=\"sticky top-0 z-20 bg-pdd-bg\">\n <div className=\"px-4 py-2 flex items-center justify-between border-b border-pdd-border/10\">\n <div className=\"flex items-center gap-3\">\n <h1 className=\"text-sm font-semibold text-pdd-text\">商品分析</h1>\n <span className=\"text-[10px] text-pdd-text-secondary/30\">{filteredProducts.length} 款商品</span>\n </div>\n <FilterToolbar tf={tf} />\n </div>\n {renderKpiCards()}\n </div>\n\n {/* Main: product list + detail side panel */}\n <div className=\"flex flex-1 min-h-0 border-t border-pdd-border/5\">\n {/* Left: product list */}\n <div className={`flex-1 min-w-0 flex flex-col overflow-hidden ${selectedProduct ? 'border-r border-pdd-border/10' : ''}`}>\n <div className=\"flex-1 overflow-y-auto\">\n {renderProductList()}\n </div>\n </div>\n\n {/* Right: product detail */}\n {selectedProduct && productStats[selectedProduct] && (\n <div className=\"w-80 shrink-0 overflow-y-auto border-l border-pdd-border/10\">\n {renderDetailPanel(productStats[selectedProduct])}\n </div>\n )}\n </div>\n\n {/* ⚡ Modals */}\n <DashboardDetailModal open={detailModal.open} title={detailModal.title} data={detailModal.data} columns={detailModal.columns} onClose={() => setDetailModal({open:false,title:'',data:[],columns:[]})} />\n\n <AnalysisProvider>\n <ProductDeepAnalysis\n isOpen={deepAnalysisOpen}\n onClose={() => setDeepAnalysisOpen(false)}\n initialProductId={deepAnalysisProductId}\n productStats={productStats}\n products={products}\n orders={filteredOrders}\n prevProductStats={prevProductStats}\n />\n </AnalysisProvider>\n </div>\n );\n }\n"